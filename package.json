{
  "name": "mae-flow-cloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mae-Flow 云端服务:Pi(pi-mono)进程内集成 + Mae-Flow 内核宿主适配",
  "scripts": {
    "probe": "tsx src/probe.ts",
    "test": "tsx scripts/clean-test-tmp.ts && tsx --test --test-timeout=180000 --test-force-exit tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.contract.json",
    "gate": "bash scripts/gate.sh",
    "fix-ratio": "bash scripts/fix-ratio.sh",
    "visual": "tsx scripts/visual-scenes.ts",
    "ui:fixtures": "tsx scripts/seed-ui-workbench-fixtures.ts",
    "ui:fixtures:reset": "tsx scripts/seed-ui-workbench-fixtures.ts --force",
    "ui:preview": "MAE_FLOW_UI_FIXTURE_MODE=1 tsx src/serve.ts --data .ui-fixtures --port 8838",
    "serve": "tsx src/serve.ts",
    "adapter": "tsx src/platformAdapter.ts",
    "pilot": "tsx src/pilot.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "pg": "^8.23.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
