      "python -W error::ResourceWarning scripts/tests/test_quality_task_cards.py"
    ],
    "selftest": [
      "python scripts/selftest.py"
    ],
    "unit_tests": [
      "python -m unittest discover -s scripts/tests -p 'test_*.py'"
    ]
  },
