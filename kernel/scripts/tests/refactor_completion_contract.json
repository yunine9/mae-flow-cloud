    "max_entrypoint_lines": {
      "scripts/mae-flow.py": 1500,
      "hooks/dispatch.py": 800
    },
    "max_business_module_lines": 500,
    "max_policy_complexity": 15,
    "private_monolith_test_imports": 0
  },
  "required_verifications": {
